# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real passwords.

# ---- identity ----
# Sets: docker image name, container name, hostname, tmux session name,
# and the window status bar label. This is the ONE value that "renames"
# the whole dev environment for a new project — no need to edit any
# other file.
WORKSPACE_NAME=ros2_ws

# ---- linux user inside the container ----
USERNAME=devuser
USER_UID=1000          # match `id -u` on your host
USER_GID=1000           # match `id -g` on your host
LINUX_PASSWORD=changeme
# 'no' disables SSH password login entirely (pubkey-only) — set this to 'no'
# only after mounting your own key via the commented volume lines in
# docker-compose.yml, or you'll lock yourself out.
SSH_PASSWORD_AUTH=yes

# ---- display ----
VNC_RESOLUTION=1920x1080
VNC_DEPTH=24

# ---- ports (host side) ----
VNC_PORT=5901
SSH_PORT=2222

# ---- ROS2 ----
ROS_DOMAIN_ID=0

# ---- used by scripts/dev.sh create-pkg ----
MAINTAINER_NAME=your-name
MAINTAINER_EMAIL=you@example.com
LICENSE_SPDX=MIT
