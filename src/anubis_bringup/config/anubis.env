#!/bin/bash
# anubis.env -- central configuration for Anubis bringup scripts.
#
# Sourced by every script in anubis_bringup/scripts/. Edit the values
# below for your robot; do not hardcode paths/IPs inside the scripts
# themselves.

# ---------------------------------------------------------------------------
# Workspace
# ---------------------------------------------------------------------------
# Where anubis_ws actually lives on THIS machine (the Jetson, running
# bare-metal -- no Docker at runtime; Docker was only used for
# development on a separate devbox).
export ANUBIS_WS_DIR="${ANUBIS_WS_DIR:-$HOME/anubis_ws}"

# ---------------------------------------------------------------------------
# Active map
# ---------------------------------------------------------------------------
# The directory anubis_mapping saves into (map.pcd, map.pgm/map.yaml,
# map_scd.bin, apriltag_anchors.yaml) and anubis_localization /
# anubis_navigation load from. ONE map is "active" at a time; point this
# at a different directory to switch maps entirely.
#
# To start a brand new map: change MAP_NAME below (or export
# ANUBIS_MAP_DIR yourself before sourcing this file), then run
# bringup_mapping.sh -- it creates the directory if it doesn't exist.
export ANUBIS_MAP_NAME="${ANUBIS_MAP_NAME:-default}"
export ANUBIS_MAP_DIR="${ANUBIS_MAP_DIR:-$HOME/anubis_maps/$ANUBIS_MAP_NAME}"

# Convenience paths derived from ANUBIS_MAP_DIR -- used by
# bringup_autonomous.sh so you don't have to type the filenames.
export ANUBIS_MAP_PCD="$ANUBIS_MAP_DIR/map.pcd"
export ANUBIS_MAP_YAML="$ANUBIS_MAP_DIR/map.yaml"

# ---------------------------------------------------------------------------
# Robot network
# ---------------------------------------------------------------------------
# genisom_l1_sdk target -- matches anubis_control's own default, only
# needed here if you want to override it from one central place.
export ANUBIS_DOG_IP="${ANUBIS_DOG_IP:-192.168.234.1}"
# Where the SDK is vendored (matches anubis_control/anubis_mapping's
# CMakeLists.txt ANUBIS_SDK_DIR convention) -- reference only, this
# variable isn't consumed by any script here, it's just documented in
# one place alongside everything else an operator might need to check.
export ANUBIS_SDK_DIR="${ANUBIS_SDK_DIR:-/opt/genisom_l1_sdk}"

# ---------------------------------------------------------------------------
# AprilTag physical size
# ---------------------------------------------------------------------------
# Edge length of the printed tag's BLACK pattern only, in meters -- do
# NOT include the white border. Measure your actual printed tag; getting
# this wrong scales every AprilTag-derived pose (mapping anchors,
# localization bootstrap/correction) by the same wrong factor.
#
# This variable is a REFERENCE, not a live override: the value that
# actually takes effect is anubis_perception/config/apriltag_params.yaml's
# own `size:` field. Edit that file directly to change it -- keep this
# variable in sync as a reminder of what it's currently set to, so you
# don't have to go digging through anubis_perception to remember.
export ANUBIS_APRILTAG_SIZE_M="${ANUBIS_APRILTAG_SIZE_M:-0.10}"
export ANUBIS_APRILTAG_FAMILY="${ANUBIS_APRILTAG_FAMILY:-36h11}"

# ---------------------------------------------------------------------------
# tmux session name -- used by every script below so they all
# find/attach/kill the SAME session consistently.
# ---------------------------------------------------------------------------
export ANUBIS_TMUX_SESSION="${ANUBIS_TMUX_SESSION:-anubis}"
