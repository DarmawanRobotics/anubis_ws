<?xml version="1.0"?>
<package format="3">
  <name>anubis_perception</name>
  <version>0.1.0</version>
  <description>
    Wraps apriltag_ros (christianrauch) for AprilTag 36h11 detection,
    remapped to Anubis's /perception/ topic convention, plus a health
    status node and a live annotated debug image (apriltag_draw) for
    troubleshooting detection during setup.
  </description>
  <maintainer email="you@example.com">Agus Darmawan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>diagnostic_updater</depend>

  <!-- External drivers, not owned by this package - installed via apt
       (ros-humble-apriltag ros-humble-apriltag-ros ros-humble-apriltag-draw)
       or anubis.repos. See docs/design/sensors.md for the full
       external-dependency list. -->
  <exec_depend>apriltag_ros</exec_depend>
  <exec_depend>apriltag_msgs</exec_depend>
  <exec_depend>apriltag_draw</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
